    "mode": "what_if",
    "probabilities": {
      "ARI": 1.0, "ATL": 1.6, "CAR": 0.6, "CHI": 7.3, "DAL": 9.0, "DET": 8.8,
      "GB": 8.3, "LA": 24.5, "MIN": 1.2, "NO": 1.0, "NYG": 0.8, "PHI": 9.0,
      "SEA": 16.0, "SF": 9.3, "TB": 0.7, "WAS": 0.9
